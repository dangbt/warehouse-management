# ===== Kho Việt — Docker self-host =====

# Mật khẩu PostgreSQL (tạo tự động bởi install.sh)
POSTGRES_PASSWORD=

# Khoá bí mật JWT (≥32 ký tự, tạo tự động bởi install.sh)
JWT_SECRET=

# Token dùng khi setup lần đầu (tạo tự động bởi install.sh)
SETUP_TOKEN=

# Loại hình kinh doanh: FNB | FASHION | RETAIL
BUSINESS_PROFILE=FNB

# Cổng HTTP truy cập web (mặc định 8080)
HTTP_PORT=8080

# Phiên bản image (dùng bởi scripts/update.sh)
KHO_VIET_VERSION=latest

# CORS origins phân cách bởi dấu phẩy (để trống = không giới hạn thêm)
CORS_ORIGINS=

# Telegram thông báo (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
